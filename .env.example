# AnnWord local frontend template
# Copy to .env.local for local frontend development. Do not commit real secrets.

# AnnWord backend API. Production uses https://api.annword.ru.
# For a locally running backend, use for example http://localhost:8080.
VITE_API_URL=http://localhost:8080

# Optional frontend settings
VITE_ADMIN_EMAILS=
GEMINI_API_KEY=

# Server-side Yandex Cloud / PostgreSQL / OAuth / Prodamus variables are documented in:
# .env.yandex.example
#
# Production does not use Supabase or Vercel as runtime components.
